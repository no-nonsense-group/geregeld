{
  "name": "geregeld",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.43",
  "engines": {
    "node": "24.x"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node scripts/ensure-supported-node.mjs && vite dev --port 3000",
    "generate-routes": "node scripts/ensure-supported-node.mjs && tsr generate",
    "build": "node scripts/ensure-supported-node.mjs && vite build && node scripts/check-legacy-spacing.mjs",
    "deploy:build": "node scripts/ensure-supported-node.mjs && vite build && node scripts/check-legacy-spacing.mjs && node scripts/migrate-for-vercel.mjs",
    "preview": "node scripts/ensure-supported-node.mjs && vite preview",
    "db:generate": "node scripts/ensure-supported-node.mjs && drizzle-kit generate",
    "db:migrate": "node scripts/ensure-supported-node.mjs && drizzle-kit migrate",
    "db:check": "node scripts/ensure-supported-node.mjs && drizzle-kit check",
    "format": "node scripts/ensure-supported-node.mjs && biome format --write .",
    "lint": "node scripts/ensure-supported-node.mjs && biome lint .",
    "check": "node scripts/ensure-supported-node.mjs && biome check .",
    "typecheck": "node scripts/ensure-supported-node.mjs && tsc --noEmit",
    "check:deprecations": "node scripts/ensure-supported-node.mjs && node scripts/check-typescript-deprecations.mjs",
    "test": "node scripts/ensure-supported-node.mjs && vitest run",
    "quality": "node scripts/ensure-supported-node.mjs && biome check . && tsc --noEmit && node scripts/check-typescript-deprecations.mjs && vitest run && node --check scripts/migrate-for-vercel.mjs && vite build && node scripts/check-legacy-spacing.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@effect/sql": "0.52.0",
    "@effect/sql-drizzle": "0.51.0",
    "@effect/sql-pg": "0.53.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.32",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "effect": "3.22.0",
    "lucide-react": "1.27.0",
    "nitro": "3.0.260610-beta",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.22.0",
    "shadcn": "4.16.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@effect/vitest": "0.30.0",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/router-cli": "1.167.21",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "drizzle-kit": "0.31.4",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
