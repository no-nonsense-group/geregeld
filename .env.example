# Local development defaults to SQLite (a file: URL). The file is created by `bun run db:migrate`.
DATABASE_URL=file:./geregeld.local.db

# For local PostgreSQL instead, use:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/geregeld

# Deployed (Vercel + Neon): set these in Vercel project settings.
DATABASE_URL_UNPOOLED=
DATABASE_MAX_CONNECTIONS=4
REGISTRATION_CODE_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=
RESEND_FROM_EMAIL="Geregeld <registratie@mail.example.com>"
